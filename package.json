{
  "name": "stael-powerbank-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @stael/storefront dev",
    "dev:storefront": "pnpm --filter @stael/storefront dev",
    "dev:admin": "pnpm --filter @stael/admin dev",
    "build": "pnpm -r build",
    "build:storefront": "pnpm --filter @stael/storefront build",
    "build:admin": "pnpm --filter @stael/admin build",
    "start:storefront": "pnpm --filter @stael/storefront start",
    "start:admin": "pnpm --filter @stael/admin start",
    "db:generate": "pnpm --filter @stael/db generate",
    "db:migrate": "pnpm --filter @stael/db migrate",
    "db:deploy": "pnpm --filter @stael/db deploy",
    "db:seed": "pnpm --filter @stael/db seed",
    "verify:orders": "pnpm --filter @stael/storefront verify:orders",
    "postinstall": "pnpm db:generate"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    },
    "ignoredBuiltDependencies": [
      "msw",
      "sharp"
    ],
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
